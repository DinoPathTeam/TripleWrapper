# Rust
/target/
**/target/
**/*.rs.bk
# NOTE: Cargo.lock is intentionally TRACKED for src/core (binary crate):
# CI must resolve byte-identical deps to what was validated locally.
# (Library-only crates would keep it ignored.)

# Python
__pycache__/
*.mo
*.py[cod]
*$py.class
*.so
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/
dist/
build/
.env
.venv/
venv/
ENV/

# Meson
/builddir/
/meson-private/
/meson-logs/

# Flatpak
/flatpak/build-dir/
/flatpak/*.flatpak
/flatpak/.flatpak-builder/

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Logs
*.log

# Temporary files
*.tmp
*.temp
*.bak

# Agent files (per AGENTS.md)
.agent/
agent-tasks.md
agent-todo.md
*.agent-temp

# Local config
config.toml
local.toml

# Test outputs
test_output/
coverage/

# Packaging
*.deb
*.rpm
*.AppImage
# Local flathub fork workspace (never commit)
flathub/

# makepkg artifacts (sources, packages, build dirs)
packaging/arch/*.tar.gz
packaging/arch/*.pkg.tar.*
packaging/arch/pkg/
packaging/arch/src/

# Editor swap/temp files
*.swp
*.kate-swp
*~
