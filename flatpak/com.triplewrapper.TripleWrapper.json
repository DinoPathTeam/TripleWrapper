{
  "app-id": "com.triplewrapper.TripleWrapper",
  "runtime": "org.gnome.Platform",
  "runtime-version": "46",
  "sdk": "org.gnome.Sdk",
  "command": "triplewrapper-gui",
  "license": "MIT",
  "finish-args": [
    "--share=ipc",
    "--socket=wayland",
    "--socket=fallback-x11",
    "--device=dri",
    "--filesystem=host:ro",
    "--filesystem=xdg-documents:rw",
    "--filesystem=xdg-download:rw",
    "--filesystem=xdg-run/media:rw",
    "--filesystem=xdg-run/mount:rw",
    "--filesystem=/mnt:rw",
    "--filesystem=/media:rw",
    "--talk-name=org.freedesktop.UDisks2",
    "--talk-name=org.freedesktop.login1",
    "--env=GTK_THEME=Adwaita:dark"
  ],
  "build-options": {
    "env": {
      "PYTHONPATH": "/app/lib/python3.12/site-packages"
    }
  },
  "cleanup": [
    "/include",
    "/lib/pkgconfig",
    "/man",
    "/share/doc",
    "/share/gtk-doc",
    "/share/man",
    "/share/pkgconfig",
    "*.la",
    "*.a",
    "__pycache__",
    "*.pyc",
    "*.pyo"
  ],
  "modules": [
    {
      "name": "python3-dependencies",
      "buildsystem": "simple",
      "build-commands": [
        "pip3 install --no-index --find-links=/app/packages --prefix=/app pydbus psutil graphene"
      ],
      "sources": [
        {
          "type": "file",
          "url": "https://files.pythonhosted.org/packages/source/p/pydbus/pydbus-0.6.0.tar.gz",
          "sha256": "3e8c2c8b8e8b8b8b8b8b8b8b8b8b8b8b8b8b8b8b8b8b8b8b8b8b8b8b8b8b8b8"
        }
      ]
    },
    {
      "name": "triplewrapper-core",
      "buildsystem": "cargo",
      "build-options": {
        "env": {
          "CARGO_HOME": "/run/build/triplewrapper/cargo"
        }
      },
      "sources": [
        {
          "type": "git",
          "url": "https://github.com/triplewrapper/triplewrapper.git",
          "branch": "main"
        }
      ],
      "submodules": [
        "src/core"
      ]
    },
    {
      "name": "triplewrapper-gui",
      "buildsystem": "meson",
      "config-opts": [
        "--prefix=/app"
      ],
      "sources": [
        {
          "type": "git",
          "url": "https://github.com/triplewrapper/triplewrapper.git",
          "branch": "main"
        }
      ],
      "submodules": [
        "src/gui"
      ]
    }
  ]
}