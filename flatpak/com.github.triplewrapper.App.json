{
  "app-id": "com.github.triplewrapper.App",
  "runtime": "org.gnome.Platform",
  "runtime-version": "46",
  "sdk": "org.gnome.Sdk",
  "command": "triplewrapper-gui",
  "license": "MIT",
  "finish-args": [
    "--share=ipc",
    "--socket=wayland",
    "--socket=fallback-x11",
    "--device=dri",
    "--filesystem=host:ro",
    "--filesystem=xdg-documents:rw",
    "--filesystem=xdg-download:rw",
    "--filesystem=xdg-run/media:rw",
    "--filesystem=xdg-run/mount:rw",
    "--filesystem=/mnt:rw",
    "--filesystem=/media:rw",
    "--talk-name=org.freedesktop.UDisks2",
    "--env=GTK_THEME=Adwaita:dark"
  ],
  "build-options": {
    "env": {
      "PYTHONPATH": "/app/lib/python3.12/site-packages"
    }
  },
  "cleanup": [
    "/include",
    "/lib/pkgconfig",
    "/man",
    "/share/doc",
    "/share/gtk-doc",
    "/share/man",
    "/share/pkgconfig",
    "*.la",
    "*.a",
    "__pycache__",
    "*.pyc",
    "*.pyo"
  ],
  "modules": [
    {
      "name": "triplewrapper-core",
      "buildsystem": "simple",
      "build-commands": [
        "cargo build --release --manifest-path src/core/Cargo.toml",
        "install -Dm755 src/core/target/release/triplewrapper-core /app/bin/triplewrapper-core"
      ],
      "build-options": {
        "env": {
          "CARGO_HOME": "/run/build/triplewrapper/cargo"
        }
      },
      "sources": [
        {
          "type": "git",
          "url": "https://github.com/DinoPathTeam/TripleWrapper.git",
          "branch": "main"
        }
      ]
    },
    {
      "name": "triplewrapper-gui",
      "buildsystem": "meson",
      "config-opts": [
        "--prefix=/app"
      ],
      "sources": [
        {
          "type": "git",
          "url": "https://github.com/DinoPathTeam/TripleWrapper.git",
          "branch": "main"
        }
      ]
    }
  ]
}
